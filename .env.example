# HubSpot private-app token (server-side only; never reaches the frontend)
HUBSPOT_TOKEN=
# HubSpot portal id (used for deep links into the CRM UI)
HUBSPOT_PORTAL_ID=9201667
# TTL for the cached crm-health / contact-health scans, in seconds
HEALTH_CACHE_TTL_SECONDS=900
# HubSpot API base URL; point it at the fake HubSpot (tools/fake_hubspot.py)
# to run the backend and the sampling probe without a real token
HUBSPOT_BASE_URL=https://api.hubapi.com
# Bounded backoff on 429/5xx (Retry-After is honoured)
HUBSPOT_MAX_RETRIES=3
# Search endpoints are limited to 5 req/s per account
SEARCH_RPS=4
# Page size for /api/export/* (list endpoint max 100, search max 200)
EXPORT_PAGE_LIMIT=100
# Optional override for the entity seed (defaults to backend/app/data/entities.yaml)
ENTITIES_PATH=
