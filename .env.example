# HubSpot private-app token (server-side only; never reaches the frontend)
HUBSPOT_TOKEN=
# HubSpot portal id (used for deep links into the CRM UI)
HUBSPOT_PORTAL_ID=9201667
# TTL for the cached crm-health / contact-health scans, in seconds
HEALTH_CACHE_TTL_SECONDS=900
# TTL for the cached contact-score scan, in seconds (defaults to 900)
# SCORING_CACHE_TTL_SECONDS=900
